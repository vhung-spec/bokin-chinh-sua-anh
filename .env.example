# Sao chép file này thành .env rồi điền giá trị.

# API key lấy tại https://platform.claude.com/ (Settings → API keys)
ANTHROPIC_API_KEY=

# Model Claude (mặc định claude-opus-5-5). Có thể đổi sang claude-sonnet-5-5 để rẻ hơn.
CLAUDE_MODEL=claude-opus-5-5

# Mức suy nghĩ: low | medium | high | xhigh | max (mặc định medium)
CLAUDE_EFFORT=medium

# Model rẻ cho việc nhỏ: dịch câu lệnh của ô Generative Fill sang tiếng Anh (mặc định claude-haiku-5-5)
CLAUDE_FAST_MODEL=claude-haiku-5-5

# Giới hạn chi phí ước tính (USD) cho MỘT yêu cầu; vượt thì Bokin tạm dừng và hỏi có làm tiếp không
CLAUDE_MAX_COST_PER_REQUEST=0.5

# Tự chuyển sang model dự phòng khi yêu cầu bị bộ lọc an toàn từ chối: default | off
CLAUDE_FALLBACKS=default

# Cổng và địa chỉ server. Giữ 127.0.0.1 để chỉ máy bạn truy cập được (server dùng API key của bạn).
PORT=3000
HOST=127.0.0.1

# ── Chỉnh sửa bằng AI tạo ảnh (xoá vật thể, đổi nền...) — tuỳ chọn ──
# Token Hugging Face (https://huggingface.co/settings/tokens, quyền "Make calls to Inference Providers").
# Bỏ trống = tắt tính năng này.
HF_TOKEN=
# Mô hình chỉnh ảnh theo chỉ dẫn (mặc định Qwen-Image-Edit-2511, giấy phép Apache-2.0)
AI_EDIT_MODEL=Qwen/Qwen-Image-Edit-2511
# Nhà cung cấp chạy mô hình: auto | fal-ai | wavespeed
AI_EDIT_PROVIDER=auto
# Cạnh dài tối đa (px) của ảnh gửi cho AI. Giá ~0,03 USD/megapixel: 1024 ≈ 0,03 USD, 1536 ≈ 0,07 USD mỗi ảnh.
AI_EDIT_MAX_SIDE=1024

# Tạm tắt Generative Fill (xoá/thêm vật thể bằng AI) dù có HF_TOKEN: công cụ chỉ còn chỉnh màu, chỉnh vùng.
# AI_EDIT=off
